generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notes     Note[]
  tasks     Task[]
  events    Event[]
  transactions Transaction[]
  categories Category[]

  @@map("users")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum RecurrenceFrequency {
  MONTHLY
}

model Note {
  id       String   @id @default(uuid())
  title   String
  content String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags     Tag[]

  @@map("notes")
}

model Tag{
  id String @id @default(uuid())
  name String @unique
  notes Note[]

  @@map("tags")
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("pending")
  priority    String   @default("medium") 
  order       Float    @default(0)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
// User relation
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
// Self-referential relation for subtasks
  parentId    String?
  parent      Task?    @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks    Task[]   @relation("TaskHierarchy")
  events      Event[]

  @@map("tasks")
  @@index([userId])
  @@index([parentId])
}

model Event {
  id        String   @id @default(uuid())
  title     String
  startTime DateTime
  endTime   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@map("events")
  @@index([userId])
  @@index([taskId])
  @@index([startTime])
}

model Transaction {
  id          String          @id @default(uuid())
  amount      Float
  type        TransactionType
  category    String
  categoryColor String?
  description String?
  isRecurring Boolean         @default(false)
  recurrenceFrequency RecurrenceFrequency?
  occurredAt  DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String?
  categoryRef Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("transactions")
  @@index([userId])
  @@index([categoryId])
  @@index([type])
  @@index([occurredAt])
}

model Category {
  id           String        @id @default(uuid())
  name         String
  color        String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("categories")
  @@index([userId])
  @@unique([userId, name])
}