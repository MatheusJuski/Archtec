generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notes     Note[]
  tasks     Task[]
  events    Event[]
  transactions Transaction[]
  categories Category[]
  monthlyGoals MonthlyGoal[]
  accountEntries AccountEntry[]

  @@map("users")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum AccountEntryType {
  PAYABLE
  RECEIVABLE
}

enum AccountEntryStatus {
  PENDING
  PAID
  OVERDUE
}

model Note {
  id       String   @id @default(uuid())
  title   String
  content String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags     Tag[]
  events   Event[]

  @@map("notes")
  @@index([userId])
  @@index([userId, title])
  @@index([userId, content])
}

model Tag{
  id String @id @default(uuid())
  name String @unique
  notes Note[]

  @@map("tags")
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("pending")
  priority    String   @default("medium") 
  order       Float    @default(0)
  dueDate     DateTime?
  isRecurring Boolean  @default(false)
  recurrenceFrequency RecurrenceFrequency?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
// User relation
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
// Self-referential relation for subtasks
  parentId    String?
  parent      Task?    @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks    Task[]   @relation("TaskHierarchy")
  events      Event[]

  @@map("tasks")
  @@index([userId])
  @@index([userId, title])
  @@index([parentId])
}

model Event {
  id        String   @id @default(uuid())
  title     String
  description String?
  startTime DateTime
  endTime   DateTime
  isRecurring Boolean @default(false)
  recurrenceFrequency RecurrenceFrequency?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  noteId    String?
  note      Note?    @relation(fields: [noteId], references: [id], onDelete: SetNull)

  @@map("events")
  @@index([userId])
  @@index([userId, title])
  @@index([taskId])
  @@index([noteId])
  @@index([startTime])
}

model Transaction {
  id          String          @id @default(uuid())
  amount      Float
  type        TransactionType
  category    String
  categoryColor String?
  description String?
  isRecurring Boolean         @default(false)
  recurrenceFrequency RecurrenceFrequency?
  occurredAt  DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String?
  categoryRef Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("transactions")
  @@index([userId])
  @@index([categoryId])
  @@index([type])
  @@index([occurredAt])
}

model Category {
  id           String        @id @default(uuid())
  name         String
  color        String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("categories")
  @@index([userId])
  @@unique([userId, name])
}

model MonthlyGoal {
  id           String   @id @default(uuid())
  month        Int
  year         Int
  category     String
  targetAmount Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("monthly_goals")
  @@index([userId, month, year])
  @@unique([userId, month, year, category])
}

model AccountEntry {
  id          String            @id @default(uuid())
  type        AccountEntryType
  status      AccountEntryStatus @default(PENDING)
  amount      Float
  category    String
  description String?
  dueDate     DateTime
  paidAt      DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account_entries")
  @@index([userId, dueDate])
  @@index([userId, status])
  @@index([userId, type])
}